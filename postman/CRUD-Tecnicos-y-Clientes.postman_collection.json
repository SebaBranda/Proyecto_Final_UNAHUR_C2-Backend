{
  "info": {
    "name": "GalacticApp - CRUD tecnicos y clientes",
    "description": "Endpoints REST listos para probar el frontend. El repositorio actual es en memoria y puede reemplazarse por MongoDB sin cambiar las rutas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tecnicoId", "value": "3" },
    { "key": "clienteId", "value": "1" }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Estado del servicio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" }
        },
        {
          "name": "Ping API",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/ping" }
        }
      ]
    },
    {
      "name": "Tecnicos - CRUD",
      "item": [
        {
          "name": "Listar tecnicos",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/tecnicos" }
        },
        {
          "name": "Obtener tecnico",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}" }
        },
        {
          "name": "Crear tecnico",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Respuesta 201', () => pm.response.to.have.status(201));",
            "const registro = pm.response.json();",
            "if (registro.id) pm.collectionVariables.set('tecnicoId', registro.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"tecnico.postman\",\n  \"contrasena\": \"tecnico123\",\n  \"nombre\": \"Tecnico Postman\",\n  \"documento\": \"40999888\",\n  \"telefono\": \"11-4000-0000\",\n  \"email\": \"tecnico.postman@galactic.app\",\n  \"direccion\": \"Direccion de prueba 123\"\n}" },
            "url": "{{baseUrl}}/api/tecnicos"
          }
        },
        {
          "name": "Actualizar tecnico - PATCH",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Tecnico actualizado\"\n}" },
            "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}"
          }
        },
        {
          "name": "Eliminar tecnico",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}" }
        }
      ]
    },
    {
      "name": "Clientes - CRUD",
      "item": [
        {
          "name": "Listar clientes",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/clientes" }
        },
        {
          "name": "Obtener cliente",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/clientes/{{clienteId}}" }
        },
        {
          "name": "Crear cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Respuesta 201', () => pm.response.to.have.status(201));",
            "const registro = pm.response.json();",
            "if (registro.id) pm.collectionVariables.set('clienteId', registro.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cliente Postman\",\n  \"documento\": \"40999777\",\n  \"telefono\": \"11-4222-0000\",\n  \"email\": \"cliente.postman@galactic.app\",\n  \"direccion\": \"Direccion de prueba 456\",\n  \"activo\": true,\n  \"coordenadas\": {\n    \"latitud\": -34.65,\n    \"longitud\": -58.62\n  },\n  \"zona\": \"Moron Centro\"\n}" },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Actualizar cliente - PATCH",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"telefono\": \"11-4333-1111\",\n  \"activo\": false\n}" },
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Eliminar cliente",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/clientes/{{clienteId}}" }
        }
      ]
    }
  ]
}
