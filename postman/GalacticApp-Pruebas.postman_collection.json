{
  "info": {
    "_postman_id": "7e96c906-526c-4e13-9bc1-2306bff7f3d1",
    "name": "Pruebas",
    "description": "Pruebas CRUD de usuarios, técnicos y clientes. Ejecutá AUTH USUARIO primero. Los GET por ID usan IDs semilla independientes; las variables usuarioId, tecnicoId y clienteId se actualizan con los IDs creados y se usan para editar/eliminar. El servidor local usa HTTPS con certificado autofirmado: desactivá SSL certificate verification en Postman para desarrollo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "tecnicoId",
      "value": "3"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "usuarioConsultaId",
      "value": "1"
    },
    {
      "key": "tecnicoConsultaId",
      "value": "3"
    },
    {
      "key": "clienteConsultaId",
      "value": "1"
    },
    {
      "key": "clienteNombre",
      "value": ""
    },
    {
      "key": "clienteEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "AUTH USUARIO",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso', function () {",
              "  pm.response.to.have.status(200);",
              "  const respuesta = pm.response.json();",
              "  pm.expect(respuesta.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('token', respuesta.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"contrasena\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "GET TODOS LOS USUARIOS",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lista de usuarios responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET USUARIO POR ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios/{{usuarioConsultaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuario encontrado', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
