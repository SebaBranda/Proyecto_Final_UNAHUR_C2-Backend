    {
      "name": "POST CREAR USUARIO",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('usuarioPrueba', 'coord.postman.' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuario creado con identificador', function () {",
              "  pm.response.to.have.status(201);",
              "  const respuesta = pm.response.json();",
              "  pm.expect(respuesta.mensaje).to.eql('Usuario creado correctamente');",
              "  pm.expect(respuesta.id).to.exist;",
              "  pm.collectionVariables.set('usuarioId', respuesta.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"ClaveDePrueba123\",\n  \"nombre\": \"Coordinador Postman\",\n  \"rolId\": 2,\n  \"activo\": true,\n  \"perfil\": {\n    \"zonaAsignada\": \"Zona Norte\",\n    \"maxTecnicosACargo\": 8\n  }\n}",
