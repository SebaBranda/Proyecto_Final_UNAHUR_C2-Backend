# Configuración del Servidor
NODE_ENV=development
PORT=3000
HTTPS_PORT=3000
HTTPS_ENABLED=false
HTTPS_KEY_PATH=certs/localhost.key
HTTPS_CERT_PATH=certs/localhost.crt

# Generar una clave aleatoria de al menos 32 bytes; no reutilizar esta plantilla.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES

# Configuración de MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGO_DB=galacticapp_db

# URI de MongoDB (se genera automáticamente en docker-compose)
# Para desarrollo local: mongodb://localhost:27017/galacticapp_db
# Para Docker: mongodb://admin:password@mongodb:27017/galacticapp_db
