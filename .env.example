# Variables de entorno de ejemplo para GalacticApp Backend.
# Copiá este archivo como .env y completá los valores.
# Con Docker no hace falta: las variables las define docker-compose.yml.

# Servidor
NODE_ENV=development
PORT=3000

# Conexión a MongoDB (obligatoria)
MONGO_URI=mongodb://localhost:27017/galacticapp_db

# Secreto para firmar los tokens: una clave aleatoria de al menos 32 bytes (obligatoria).
# No reutilizar este valor de ejemplo.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES

# Orígenes que pueden llamar a la API, separados por coma (la web en desarrollo).
CORS_ORIGIN=http://localhost:5173

# true para cargar los datos demo al iniciar (solo agrega los que faltan).
SEED_DEMO_DATA=false

# HTTPS directo desde Node (opcional). En desarrollo, si faltan los certificados, se genera
# uno autofirmado. HTTPS_PORT reemplaza a PORT cuando está definido.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=certs/localhost.key
HTTPS_CERT_PATH=certs/localhost.crt
